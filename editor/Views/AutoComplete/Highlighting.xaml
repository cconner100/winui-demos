<Page x:Class="Syncfusion.EditorDemos.WinUI.Views.AutoComplete.Highlighting"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Syncfusion.EditorDemos.WinUI"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:common="using:Syncfusion.DemosCommon.WinUI"
      xmlns:editors="using:Syncfusion.UI.Xaml.Editors"
      mc:Ignorable="d"
      Background="Transparent">

    <Page.DataContext>
        <local:ListViewModel />
    </Page.DataContext>
    <ScrollViewer>
        <StackPanel IsTabStop="True">
            <common:DemoLayout HeaderText="The AutoComplete control supports highlighting the search text and makes it easy to select item(s) from the dropdown list."
                               XamlSource="{common:ConditionalXAML  Individual=Syncfusion.EditorDemos.WinUI/Assets/AutoComplete/Highlighting_xaml.txt,
                                                     Common=Editor/Assets/AutoComplete/Highlighting_xaml.txt}">
                <common:DemoLayout.Example>
                    <editors:SfAutoComplete x:Name="autoComplete"
                                            Width="250"
                                            Header="Type a country name"
                                            PlaceholderText="Search a country"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            SelectionMode="Single"
                                            TextHighlightMode="Matched"
                                            ItemsSource="{Binding Countries}"
                                            HighlightedTextFontSize="{Binding ElementName=fontSize,Path=SelectedIndex}"
                                            HighlightedTextFontStyle="{Binding ElementName=fontStyle,Path=SelectedItem}"
                                            HighlightedTextForeground="{Binding ElementName=foregroundColorPicker,Path=SelectedBrush}"
                                            HighlightedTextFontWeight="{Binding ElementName=fontWeight,Path=SelectedIndex}" />
                </common:DemoLayout.Example>
                <common:DemoLayout.Options>
                    <StackPanel>
                        <editors:SfComboBox Name="textSearchMode"
                                            MinWidth="220"
                                            MinHeight="40"
                                            Margin="10"
                                            Header="TextSearchMode"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{common:EnumToStringValues Type=editors:AutoCompleteTextSearchMode}"
                                            SelectedItem="{Binding ElementName=autoComplete ,Path=TextSearchMode,Converter={common:StringToEnumValueConverter Type=editors:AutoCompleteTextSearchMode},Mode=TwoWay}" />
                        <editors:SfComboBox Name="textHighlightMode"
                                            MinWidth="220"
                                            MinHeight="40"
                                            Margin="10"
                                            Header="TextHighlightMode"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{common:EnumToStringValues Type=editors:AutoCompleteTextHighlightMode}"
                                            SelectedItem="{Binding ElementName=autoComplete,Path=TextHighlightMode,Converter={common:StringToEnumValueConverter Type=editors:AutoCompleteTextHighlightMode},Mode=TwoWay}"
                                            SelectionChanged="OnTextHighlightModeSelectionChanged" />
                        <editors:SfComboBox Name="fontStyle"
                                            MinWidth="220"
                                            MinHeight="40"
                                            Margin="10"
                                            Header="HighlightedTextFontStyle"
                                            HorizontalAlignment="Stretch"
                                            SelectedIndex="0"
                                            SelectionChanged="OnFontStyleSelectionChanged">
                            <x:String>Normal</x:String>
                            <x:String>Italic</x:String>
                            <x:String>Oblique</x:String>
                        </editors:SfComboBox>
                        <editors:SfComboBox x:Name="fontWeight"
                                            Header="HighlightedTextFontWeight"
                                            MinWidth="220"
                                            MinHeight="40"
                                            Margin="10"
                                            HorizontalAlignment="Stretch"
                                            SelectedIndex="0"
                                            SelectionChanged="OnFontWeightSelectionChanged">
                            <x:String>Bold</x:String>
                            <x:String>ExtraBold</x:String>
                            <x:String>ExtraLight</x:String>
                            <x:String>Light</x:String>
                            <x:String>Medium</x:String>
                            <x:String>Normal</x:String>
                            <x:String>SemiBold</x:String>
                            <x:String>SemiLight</x:String>
                            <x:String>Thin</x:String>
                            <x:String>Black</x:String>
                            <x:String>ExtraBlack</x:String>
                        </editors:SfComboBox>
                        <editors:SfComboBox x:Name="fontSize"
                                            Header="HighlightedTextFontSize"
                                            MinWidth="220"
                                            MinHeight="40"
                                            Margin="10"
                                            HorizontalAlignment="Stretch"
                                            SelectedIndex="5"
                                            SelectionChanged="OnFontSizeSelectionChanged">
                            <x:String>8</x:String>
                            <x:String>9</x:String>
                            <x:String>10</x:String>
                            <x:String>11</x:String>
                            <x:String>12</x:String>
                            <x:String>14</x:String>
                            <x:String>16</x:String>
                            <x:String>18</x:String>
                            <x:String>20</x:String>
                            <x:String>22</x:String>
                            <x:String>24</x:String>
                            <x:String>26</x:String>
                            <x:String>28</x:String>
                            <x:String>36</x:String>
                        </editors:SfComboBox>
                        <TextBlock Text="HighlightedTextForeground"
                                   Name="foregroundHeader"
                                   Margin="5,0,0,5"
                                   Padding="5" />
                        <editors:SfDropDownColorPalette x:Name="foregroundColorPicker"
                                                        Width="80"
                                                        Margin="10,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        SelectedBrush="Black"
                                                        DropDownMode="Split">
                            <editors:SfDropDownColorPalette.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                  FontSize="14"
                                                  Margin="2"
                                                  Glyph="&#xE97F;" />
                                        <Rectangle Fill="{Binding}"
                                                   Stretch="Fill"
                                                   Width="24"
                                                   Height="4"
                                                   Margin="2" />
                                    </StackPanel>
                                </DataTemplate>
                            </editors:SfDropDownColorPalette.ContentTemplate>
                        </editors:SfDropDownColorPalette>
                    </StackPanel>
                </common:DemoLayout.Options>
            </common:DemoLayout>
        </StackPanel>
    </ScrollViewer>
</Page>
